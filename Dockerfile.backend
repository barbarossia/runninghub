FROM node:20-alpine AS base

FROM base AS deps
RUN apk add --no-cache python3 make g++
WORKDIR /app

COPY runninghub-nextjs/package*.json ./
RUN npm ci

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY runninghub-nextjs/ .

ENV RUNNINGHUB_BUILD_TARGET=backend
ENV WORKSPACE_PATH=/data
RUN mkdir -p /data
RUN npm run build:backend

FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
# Ensure Python can import runninghub_cli without install
ENV PYTHONPATH=/app
# Ensure Next.js cache is writable outside /app
ENV NEXT_CACHE_DIR=/data/runninghub-cache
# Configurable workspace directory. Override at runtime with -e WORKSPACE_PATH=/your/path
ENV WORKSPACE_PATH=/data/workspace

RUN apk add --no-cache python3 py3-pip su-exec ffmpeg

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Create workspace directory with correct ownership
RUN mkdir -p /data/workspace && chown nextjs:nodejs /data/workspace
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY requirements.txt ./
COPY runninghub_cli ./runninghub_cli


# Ensure runtime user can import runninghub_cli
RUN chown -R nextjs:nodejs ./runninghub_cli \
  && chmod -R a+rX ./runninghub_cli


RUN python3 -m pip install --no-cache-dir --break-system-packages -r requirements.txt

EXPOSE 3000

CMD ["/bin/sh", "-c", "mkdir -p /data/runninghub-tasks /data/workspace /data/workflows /data/runninghub-cache /home/nextjs/Downloads/workspace && ln -sfn /data/workflows /home/nextjs/Downloads/workspace/workflows && chown -R nextjs:nodejs /data /home/nextjs/Downloads && exec su-exec nextjs node server.js"]
